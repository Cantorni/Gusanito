{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/landing/*", "/*.{png,ico,json,js,css,txt}"]
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".geojson": "application/geo+json",
    ".pmtiles": "application/octet-stream"
  }
}
